@using GKit.BlazorExt
@using Microsoft.EntityFrameworkCore
@typeparam T where T : class
@typeparam TForm where TForm : IComponent, IEditEntityForm<T>
@typeparam TValidator where TValidator : AbstractValidatorBase<T>

@inject HtmlAttrSetterService setter
@inject TValidator validator

<MudDialog>
  <TitleContent>
    <MudText Typo="Typo.h6">@Title</MudText>
  </TitleContent>
  <DialogContent>
    <div @ref="container">
      <MudForm @ref="_form" Model="@Model" Validation="@((object?)validator.ValidateValueAsync)" ValidationDelay="0"
               IsValidChanged="p => { }" IsTouchedChanged="p => { }">
        <DynamicComponent @ref="_dynamicComponent" Type="typeof(TForm)" Parameters="_formParameters"/>
      </MudForm>
    </div>
  </DialogContent>
  <DialogActions>
    <MudStack Row>
      @*
        Was Disabled="!IsTouched": EntityGrid.NewAsync can hand the dialog a pre-filled model via
        NewValueFactory, and accepting those defaults without editing a field left Save disabled
        forever. Validation decides correctness; the button only guards double submission.
      *@
      <MudButton Color="Color.Primary" OnClick="SubmitAsync" Disabled="_submitting">Salva</MudButton>
      <MudButton Color="Color.Error" OnClick="CancelAsync">Annulla</MudButton>
    </MudStack>
  </DialogActions>
</MudDialog>

@code {
  protected MudForm? _form;
  protected DynamicComponent? _dynamicComponent;
  
  ElementReference container;

  [CascadingParameter] protected IMudDialogInstance _mudDialog { get; set; } = default!;

  [Parameter] public string Title { get; set; } = "Modifica Elemento";

  [Parameter] public T Model { get; set; } = default!;

  [Parameter] public DbContext Context { get; set; } = default!;
  
  protected Dictionary<string, object> _formParameters = new Dictionary<string, object>();

  protected override void OnParametersSet()
  {
    Model = Model ?? EmptyValueFactory();

    _formParameters = new Dictionary<string, object>()
    {
      { nameof(IEditEntityForm<T>.Model), Model },
      { nameof(IEditEntityForm<T>.Context), Context }
    };
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    // Only once: this used to make a JS interop round trip on every re-render, i.e. on every
    // keystroke that re-rendered the form.
    if (firstRender)
      await setter.SetAttributes(container, new Dictionary<string, object>() { { "autocomplete", "--off" } }, "input");

    await base.OnAfterRenderAsync(firstRender);
  }

  protected bool _submitting;

  protected async Task SubmitAsync()
  {
    if (_submitting) return;
    _submitting = true;
    try
    {
      await SubmitCoreAsync();
    }
    finally
    {
      _submitting = false;
    }
  }

  private async Task SubmitCoreAsync()
  {
    await ((_dynamicComponent?.Instance as IEditEntityForm<T>)?.OnBeforeValidationAsync() ?? Task.CompletedTask);
    
    await _form!.ValidateAsync();
    
    await ((_dynamicComponent?.Instance as IEditEntityForm<T>)?.OnAfterValidationAsync(_form.IsValid) ?? Task.CompletedTask);
    
    if (_form.IsValid)
    {
      var shouldSubmit = await ((_dynamicComponent?.Instance as IEditEntityForm<T>)?.OnBeforeSubmitAsync() ?? Task.FromResult(true));
      
      if (shouldSubmit)
        _mudDialog.Close<T>(Model);
    }
  }

  protected async Task CancelAsync()
  {
    await _form!.ResetValidationAsync();
    _mudDialog.Cancel();
  }

}