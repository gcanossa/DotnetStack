{
  "$schema": "http://json.schemastore.org/template",
  "author": "Gianmaria Canossa",
  "classifications": [
    "CLI",
    "GKit"
  ],
  "identity": "GKit.Templates.Item.CliRunner",
  "name": "GKit command line runner",
  "shortName": "gkit-clirunner",
  "description": "An ICommandLineRunner: a one-off command that runs inside the built host, which Application.Wrap dispatches from argv before host.Run().",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "sourceName": "SampleCommandLineRunner",
  "defaultName": "SampleCommandLineRunner",
  "preferNameDirectory": false,
  "symbols": {
    "namespace": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "App.CliRunners",
      "replaces": "GKIT-NAMESPACE"
    },
    "flag": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "--sample",
      "replaces": "GKIT-FLAG",
      "description": "Argument that selects this runner."
    }
  }
}