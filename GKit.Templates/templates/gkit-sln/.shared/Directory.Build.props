<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- Shared build settings for every project in the solution. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Nerdbank.GitVersioning is declared as a GlobalPackageReference in Directory.Packages.props:
    under Central Package Management a PackageReference here may not carry a Version.
  -->
</Project>
