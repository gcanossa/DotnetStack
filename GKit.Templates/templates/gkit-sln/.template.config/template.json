{
  "$schema": "http://json.schemastore.org/template",
  "author": "Gianmaria Canossa",
  "classifications": [ "Solution", "GKit" ],
  "identity": "GKit.Templates.Solution",
  "name": "GKit solution root",
  "shortName": "gkit-sln",
  "description": "Solution root for a GKit application: slnx, Central Package Management, Nerdbank.GitVersioning, the shared release script, a CI workflow and a docker-compose matched to the database provider.",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "GKit.Sln1",
  "preferNameDirectory": true,

  "symbols": {
    "db": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "sqlserver",
      "description": "Database provider the docker-compose service is generated for.",
      "choices": [
        { "choice": "sqlserver", "description": "Microsoft SQL Server" },
        { "choice": "npgsql", "description": "PostgreSQL" },
        { "choice": "mysql", "description": "MySQL" },
        { "choice": "sqlite", "description": "SQLite, no compose service" },
        { "choice": "none", "description": "No database" }
      ]
    },
    "rid": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "win-x64",
      "replaces": "GKIT-RID",
      "description": "Runtime identifier the release script publishes for.",
      "choices": [
        { "choice": "win-x64", "description": "Windows x64" },
        { "choice": "linux-x64", "description": "Linux x64" },
        { "choice": "linux-arm64", "description": "Linux arm64" }
      ]
    },
    "ci": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Emit .github/workflows/ci.yaml."
    },

    "db_any": { "type": "computed", "value": "(db != \"none\" && db != \"sqlite\")" },
    "db_sqlserver": { "type": "computed", "value": "(db == \"sqlserver\")" },
    "db_npgsql": { "type": "computed", "value": "(db == \"npgsql\")" },
    "db_mysql": { "type": "computed", "value": "(db == \"mysql\")" }
  },

  "sources": [
    {
      "source": "./.shared/",
      "target": "./",
      "modifiers": [
        { "condition": "(!ci)", "exclude": [ ".github/**" ] },
        { "condition": "(db == \"none\")", "exclude": [ "resetdb.sh" ] }
      ],
      "rename": { "gitignore": ".gitignore" }
    },
    { "source": "./.db/sqlserver/", "target": "./", "condition": "(db_sqlserver)" },
    { "source": "./.db/npgsql/", "target": "./", "condition": "(db_npgsql)" },
    { "source": "./.db/mysql/", "target": "./", "condition": "(db_mysql)" }
  ]
}
