{
  "Kestrel": {
    //#if (httpsCerts)
    "Certificates": {
      "Default": {
        "Path": "certs/certificate.pfx",
        "Password": "password"
      }
    },
    //#endif
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      },
      "Https": {
        "Url": "https://0.0.0.0:5001"
      }
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Expressions"
    ],
    "MinimumLevel": "Information",
    "WriteTo:Console": "Console",
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  //#if (db_sqlserver)
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=GKit.App1;User Id=sa;Password=development;Encrypt=True;TrustServerCertificate=True"
  },
  //#endif
  //#if (db_npgsql)
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=5432;Database=GKit.App1;User Id=postgres;Password=development;"
  },
  //#endif
  //#if (db_mysql)
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=GKit.App1;User Id=root;Password=development;"
  },
  //#endif
  //#if (db_sqlite)
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=GKit.App1.db"
  },
  //#endif
  // One "GKit" object, not one per feature: duplicate keys would silently drop all but the last.
  //#if (quartz || auth_ad || auth_simple)
  "GKit": {
    //#if (quartz)
    "Quartz": {
      "Schedules": []
    }
    //#endif
    //#if (quartz && (auth_ad || auth_simple))
    ,
    //#endif
    //#if (auth_ad)
    "ActiveDirectory": {
      "Host": "",
      "Port": 636,
      "Domain": "",
      "QueryBase": ""
    }
    //#endif
    //#if (auth_simple)
    "SimpleAuthentication": {
      "AuthenticationType": "Password"
    }
    //#endif
  },
  //#endif
  "App": {},
  "AllowedHosts": "*"
}
