@page "/account/login"
@inherits LoginBase
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Authorization

@* Deliberately plain markup: the login page is the one screen that must render identically
   whichever GKit UI adapter the application was scaffolded with. *@

<PageTitle>Sign in</PageTitle>

<section class="login">
    <h1>Sign in</h1>

    @if (FailedLoginAttempt)
    {
        <p class="validation-message">Wrong user name or password</p>
    }

    <EditForm Model="Model" FormName="LoginUser" OnValidSubmit="LoginUser" method="post">
        <DataAnnotationsValidator />

        <label for="username">User name</label>
        <InputText id="username" @bind-Value="Model!.Username" autocomplete="username" />
        <ValidationMessage For="() => Model!.Username" />

        <label for="password">Password</label>
        <InputText id="password" type="password" @bind-Value="Model!.Password" autocomplete="current-password" />
        <ValidationMessage For="() => Model!.Password" />

        <button type="submit">Sign in</button>
    </EditForm>
</section>

@code {
    protected override void OnInitialized() => Model ??= new Credentials();
}
