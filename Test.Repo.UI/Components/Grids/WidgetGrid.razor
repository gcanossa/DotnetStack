@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<DemoDbContext> Factory

<EntityGrid @ref="Grid" T="Widget" TDialog="EditWidgetDialog" Title="Widgets"
            QueryFactory="DemoQueries.Widgets"
            ContextFactory="() => Factory.CreateDbContext()"
            SharedContext="SharedContext"
            ToStringFunc="DemoQueries.DescribeWidget"
            Exportable="true" Refreshable="true"
            RowControls="@_extraControls"
            DragDropColumnReordering="true"
            ColumnResizeMode="ResizeMode.Column">
  <Columns>
    <PropertyColumn Property="x => x.Id" Title="Id" />
    <PropertyColumn Property="x => x.Name" Title="Name" />
    <PropertyColumn Property="x => x.Quantity" Title="Quantity" />
    @* A nullable navigation, so grid sorting exercises the null-checking order path. *@
    <PropertyColumn Property="x => x.Category!.Name" Title="Category" />
    <PropertyColumn Property="x => x.CreatedAt" Title="Created" />
    <TemplateColumn Title="Has notes">
      <CellTemplate>
        @(string.IsNullOrEmpty(context.Item.Notes) ? "-" : "yes")
      </CellTemplate>
    </TemplateColumn>
  </Columns>
</EntityGrid>

@code {
  [Parameter] public DbContext? SharedContext { get; set; }

  [Parameter] public EventCallback<Widget> OnDuplicate { get; set; }

  public EntityGrid<Widget, EditWidgetDialog> Grid { get; set; } = default!;

  private ICollection<GridRowControl<Widget>> _extraControls = [];

  protected override void OnInitialized()
  {
    base.OnInitialized();

    // A caller-supplied row control, in the neutral shape both adapters accept.
    _extraControls.Add(new GridRowControl<Widget>
    {
      Text = "Duplicate",
      Icon = UiIcon.ContentCopy,
      Color = UiColor.Primary,
      Action = ctx => OnDuplicate.InvokeAsync(ctx.Item),
      Disabled = ctx => ctx.Item.Quantity == 0
    });
  }
}
