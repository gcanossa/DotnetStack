@inject NavigationManager NavigationManager

@code {
  [CascadingParameter]
  public AuthenticationOptions Options { get; set; } = new();

  protected override void OnInitialized()
  {
    // A relative path, not NavigationManager.Uri: the absolute form is rejected by the
    // open-redirect guard in LoginComponentBase and the user would lose their place.
    var returnUrl = Uri.EscapeDataString(LocalUrl.CurrentPath(NavigationManager));

    NavigationManager.NavigateTo($"{Options.LoginPath}?returnUrl={returnUrl}", forceLoad: true);
  }
}
