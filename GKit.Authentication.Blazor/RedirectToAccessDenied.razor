@inject NavigationManager NavigationManager

@code {
  [CascadingParameter]
  public AuthenticationOptions Options { get; set; } = new();
  protected override void OnInitialized()
  {
    var returnUrl = Uri.EscapeDataString(LocalUrl.CurrentPath(NavigationManager));

    NavigationManager.NavigateTo($"{Options.AccessDeniedPath}?returnUrl={returnUrl}", forceLoad: true);
  }
}
