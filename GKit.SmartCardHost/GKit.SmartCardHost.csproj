<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>library</OutputType>
        <!--
          Microsoft.NET.Sdk.Web defaults IsPackable to false because it targets applications.
          Without this the package silently does not build, even though consumers reference
          GKit.SmartCardHost from NuGet.
        -->
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="PCSC" Version="7.0.1" />
    </ItemGroup>
</Project>
