<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
    <MudTimePicker Label="@StartLabel" Time="Value?.Start" TimeChanged="OnStartChanged" Disabled="@Disabled" />
    <MudText>–</MudText>
    <MudTimePicker Label="@EndLabel" Time="Value?.End" TimeChanged="OnEndChanged" Disabled="@Disabled" />
</MudStack>

@code {
    [Parameter] public TimeRange? Value { get; set; }
    [Parameter] public EventCallback<TimeRange> ValueChanged { get; set; }

    [Parameter] public string StartLabel { get; set; } = "Start";
    [Parameter] public string EndLabel { get; set; } = "End";

    [Parameter] public bool Disabled { get; set; }

    private async Task OnStartChanged(TimeSpan? t)
    {
        Value ??= new TimeRange();
        Value.Start = t;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnEndChanged(TimeSpan? t)
    {
        Value ??= new TimeRange();
        Value.End = t;
        await ValueChanged.InvokeAsync(Value);
    }
}
